# Secrets — NEVER commit
.env
.env.*
!.env.example
config/.env

# Claude Code / user-local settings — NEVER commit (user machine paths + permission mode)
.claude/settings.local.json
settings.local.json
**/settings.local.json

# Defense-in-depth: common secret filename patterns
*.pem
*.key
!*.key.example
id_rsa
id_ed25519
credentials.json
secrets.json
*.p12
*.pfx

# Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
*.egg-info/
.venv/
.venv-v2/
venv/
.claude/.current-lang

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*~

# Build / generated
dist/
build/
*.log

# Bab-ilu internals
wiki/_index/edges.jsonl.bak
wiki/_log/*.bak

